[
  {
    "id": "storefront",
    "name": "Storefront",
    "layer": "frontend",
    "runtime": "React",
    "port": null,
    "summary": "Browse, product page, cart, and checkout for the classroom catalog.",
    "owns": ["pages", "cart state"],
    "calls": ["gateway"],
    "endpoints": []
  },
  {
    "id": "lab-console",
    "name": "Lab console",
    "layer": "frontend",
    "runtime": "React",
    "port": null,
    "summary": "Service map, live traces, metrics, and the Compose / ECS / EKS blueprints.",
    "owns": ["monitoring view", "deploy view"],
    "calls": ["gateway"],
    "endpoints": []
  },
  {
    "id": "assistant-ui",
    "name": "Shopping assistant",
    "layer": "frontend",
    "runtime": "React + server function",
    "port": null,
    "summary": "Student asks in plain language. Grok answers on the server. The key never reaches the browser.",
    "owns": ["prompt", "model reply"],
    "calls": ["recommendation"],
    "endpoints": []
  },
  {
    "id": "gateway",
    "name": "API gateway",
    "layer": "edge",
    "runtime": "Node.js",
    "port": 4000,
    "summary": "One front door. Routes, request logs, and the checkout saga.",
    "owns": ["routing", "saga", "request logs"],
    "calls": ["catalog", "search", "pricing", "inventory", "cart", "order", "payment", "shipping", "review", "user", "notification", "recommendation"],
    "endpoints": ["GET /api/services", "GET /api/catalog/products", "GET /api/catalog/products/:id", "GET /api/search?q=", "GET /api/reviews/:id", "POST /api/quote", "POST /api/eta", "POST /api/checkout", "GET /api/orders", "POST /api/assistant"]
  },
  {
    "id": "catalog",
    "name": "Catalog",
    "layer": "backend",
    "runtime": "Node.js",
    "port": 4001,
    "summary": "Products and categories. The fixture catalog stands in for a product database.",
    "owns": ["products", "categories"],
    "calls": [],
    "endpoints": ["GET /categories", "GET /products", "GET /products/:id"]
  },
  {
    "id": "search",
    "name": "Search",
    "layer": "backend",
    "runtime": "Node.js",
    "port": 4002,
    "summary": "Keyword search across name, copy, category, and tags.",
    "owns": ["query"],
    "calls": [],
    "endpoints": ["GET /search?q="]
  },
  {
    "id": "pricing",
    "name": "Pricing",
    "layer": "backend",
    "runtime": "Node.js",
    "port": 4003,
    "summary": "Sell price, MRP, and the STUDIO coupon (₹100 off from ₹999).",
    "owns": ["quotes", "coupons"],
    "calls": [],
    "endpoints": ["POST /quote"]
  },
  {
    "id": "inventory",
    "name": "Inventory",
    "layer": "backend",
    "runtime": "Node.js",
    "port": 4004,
    "summary": "Stock, reserve, commit, and release. A failed payment gives the units back.",
    "owns": ["stock", "reservations"],
    "calls": [],
    "endpoints": ["GET /stock/:id", "POST /reserve", "POST /commit", "POST /release"]
  },
  {
    "id": "cart",
    "name": "Cart",
    "layer": "backend",
    "runtime": "Node.js",
    "port": 4005,
    "summary": "Server-side carts. Checkout clears the classroom cart at the end of the saga.",
    "owns": ["carts"],
    "calls": [],
    "endpoints": ["POST /carts", "GET /carts/:id", "POST /carts/:id/items", "POST /carts/clear"]
  },
  {
    "id": "order",
    "name": "Orders",
    "layer": "backend",
    "runtime": "Node.js",
    "port": 4006,
    "summary": "Creates the order only after payment is authorized.",
    "owns": ["orders"],
    "calls": [],
    "endpoints": ["POST /orders", "GET /orders"]
  },
  {
    "id": "payment",
    "name": "Payments",
    "layer": "backend",
    "runtime": "Node.js",
    "port": 4007,
    "summary": "Mock UPI, card, and cash authorization. forceFail declines and triggers compensation.",
    "owns": ["authorizations"],
    "calls": [],
    "endpoints": ["POST /authorize"]
  },
  {
    "id": "shipping",
    "name": "Shipping",
    "layer": "backend",
    "runtime": "Node.js",
    "port": 4008,
    "summary": "Six-digit pincode to a hub and an ETA. 560… is Bengaluru, next day.",
    "owns": ["eta"],
    "calls": [],
    "endpoints": ["POST /eta"]
  },
  {
    "id": "review",
    "name": "Reviews",
    "layer": "backend",
    "runtime": "Node.js",
    "port": 4009,
    "summary": "Ratings and short reviews stored with the catalog fixture.",
    "owns": ["reviews"],
    "calls": [],
    "endpoints": ["GET /products/:id/reviews"]
  },
  {
    "id": "user",
    "name": "Profiles",
    "layer": "backend",
    "runtime": "Node.js",
    "port": 4010,
    "summary": "A fixed classroom profile, Asha Menon. No sign-in in this lab.",
    "owns": ["profile fixture"],
    "calls": [],
    "endpoints": ["GET /users/demo"]
  },
  {
    "id": "notification",
    "name": "Notifications",
    "layer": "backend",
    "runtime": "Node.js",
    "port": 4011,
    "summary": "Queues an order-placed event. In production this would send mail or SMS.",
    "owns": ["events"],
    "calls": [],
    "endpoints": ["POST /notify", "GET /notifications"]
  },
  {
    "id": "recommendation",
    "name": "Recommendations",
    "layer": "backend",
    "runtime": "Node.js",
    "port": 4012,
    "summary": "Ranks the catalog from the question. If XAI_API_KEY is set, /assist also asks Grok.",
    "owns": ["ranking", "optional model"],
    "calls": [],
    "endpoints": ["POST /rank", "POST /assist"]
  },
  {
    "id": "auth",
    "name": "Auth",
    "layer": "backend",
    "runtime": "Node.js",
    "port": 4013,
    "summary": "Register and login. Passwords are scrypt hashes in Postgres. Sessions live in Redis (ElastiCache on AWS).",
    "owns": ["users", "sessions"],
    "calls": ["postgres", "redis", "rabbitmq"],
    "endpoints": ["POST /register", "POST /login", "GET /me"]
  },
  {
    "id": "verification",
    "name": "Verification",
    "layer": "backend",
    "runtime": "Node.js",
    "port": 4014,
    "summary": "Email and mobile OTP. Code sits in Redis for 5 minutes and is published to RabbitMQ. Stdout carries the code so Kibana can show it.",
    "owns": ["otp"],
    "calls": ["redis", "rabbitmq"],
    "endpoints": ["POST /email/send", "POST /email/confirm", "POST /mobile/send", "POST /mobile/confirm"]
  },
  {
    "id": "tracking",
    "name": "Tracking",
    "layer": "backend",
    "runtime": "Node.js",
    "port": 4015,
    "summary": "Shipment scans: created, picked_up, in_transit, out_for_delivery, delivered. Stored in Postgres.",
    "owns": ["shipments"],
    "calls": ["postgres", "rabbitmq"],
    "endpoints": ["POST /shipments", "POST /shipments/:id/scan", "GET /shipments/:id"]
  },
  {
    "id": "frontend-service",
    "name": "Frontend container",
    "layer": "frontend",
    "runtime": "Node.js",
    "port": 4173,
    "summary": "Shop UI image. The browser calls the API gateway only.",
    "owns": ["pages"],
    "calls": ["gateway"],
    "endpoints": ["GET /"]
  },
  {
    "id": "prometheus",
    "name": "Prometheus",
    "layer": "platform",
    "runtime": "Prometheus",
    "port": 9090,
    "summary": "Scrapes /metrics on every Node service every 5 seconds.",
    "owns": ["metrics"],
    "calls": ["gateway", "catalog", "search", "pricing", "inventory", "cart", "order", "payment", "shipping", "review", "user", "notification", "recommendation"],
    "endpoints": ["GET /metrics"]
  },
  {
    "id": "grafana",
    "name": "Grafana",
    "layer": "platform",
    "runtime": "Grafana",
    "port": 3000,
    "summary": "Dashboards on top of Prometheus. Classroom login is admin / classroom.",
    "owns": ["dashboards"],
    "calls": ["prometheus"],
    "endpoints": []
  }
]
